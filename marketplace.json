{
  "$schema": "https://getbb.app/schemas/marketplace.schema.json",
  "schemaVersion": 1,
  "name": "gigapay",
  "displayName": "Gigapay BB plugins",
  "description": "BB plugins maintained by the Gigapay team.",
  "plugins": [
    {
      "id": "linear-issues",
      "displayName": "Linear Issues",
      "description": "Browse your Linear issues and start a BB thread from any ticket.",
      "icon": "SquareKanban",
      "tags": [
        "linear",
        "issues",
        "productivity"
      ],
      "author": {
        "name": "Gigapay",
        "github": "gigapay"
      },
      "source": {
        "git": {
          "url": "https://github.com/gigapay/bb-marketplace.git",
          "subdir": "plugins/linear-issues",
          "range": ">=0.1.0 <1.0.0",
          "tagPrefix": "linear-issues/"
        }
      }
    },
    {
      "id": "usage-bar",
      "displayName": "Usage Bar",
      "description": "Always-visible provider usage bars in the sidebar footer, Orca style.",
      "icon": "ChartColumn",
      "tags": [
        "usage",
        "providers",
        "productivity"
      ],
      "author": {
        "name": "Gigapay",
        "github": "gigapay"
      },
      "source": {
        "git": {
          "url": "https://github.com/gigapay/bb-marketplace.git",
          "subdir": "plugins/usage-bar",
          "range": ">=0.1.0 <1.0.0",
          "tagPrefix": "usage-bar/"
        }
      }
    },
    {
      "id": "github-kit",
      "displayName": "GitHub Kit",
      "description": "Your GitHub PRs in BB: a PR tab per thread with live checks, reviewers, comments you can reply to, resolve and send to the agent, plus inline review comments in the diff.",
      "icon": "GitPullRequest",
      "tags": [
        "github",
        "pull-requests",
        "productivity"
      ],
      "author": {
        "name": "Gigapay",
        "github": "gigapay"
      },
      "source": {
        "git": {
          "url": "https://github.com/gigapay/bb-marketplace.git",
          "subdir": "plugins/github-kit",
          "range": ">=0.1.0 <1.0.0",
          "tagPrefix": "github-kit/"
        }
      }
    },
    {
      "id": "pi-provider",
      "displayName": "Pi",
      "description": "bb's Pi provider with pi-toolbox subagents in the native agent display, /reload, and every Pi-loaded skill in the / menu.",
      "icon": "Terminal",
      "tags": [
        "pi",
        "provider",
        "agents"
      ],
      "author": {
        "name": "Gigapay",
        "github": "gigapay"
      },
      "source": {
        "git": {
          "url": "https://github.com/gigapay/bb-marketplace.git",
          "subdir": "plugins/pi-provider",
          "range": ">=0.1.0 <1.0.0",
          "tagPrefix": "pi-provider/"
        }
      }
    },
    {
      "id": "machine-stats",
      "displayName": "Machine Stats",
      "description": "Live CPU, RAM and disk usage of the thread's machine in the sidebar footer.",
      "icon": "Activity",
      "tags": [
        "monitoring",
        "machines",
        "productivity"
      ],
      "author": {
        "name": "Gigapay",
        "github": "gigapay"
      },
      "source": {
        "git": {
          "url": "https://github.com/gigapay/bb-marketplace.git",
          "subdir": "plugins/machine-stats",
          "range": ">=0.1.0 <1.0.0",
          "tagPrefix": "machine-stats/"
        }
      }
    },
    {
      "id": "traefik-stacks",
      "displayName": "Traefik Stacks",
      "description": "Staging slugs and Traefik services on the thread's machine, with one-click destroy, in the sidebar footer.",
      "icon": "Network",
      "tags": [
        "docker",
        "traefik",
        "staging"
      ],
      "author": {
        "name": "Gigapay",
        "github": "gigapay"
      },
      "source": {
        "git": {
          "url": "https://github.com/gigapay/bb-marketplace.git",
          "subdir": "plugins/traefik-stacks",
          "range": ">=0.1.0 <1.0.0",
          "tagPrefix": "traefik-stacks/"
        }
      }
    }
  ]
}
