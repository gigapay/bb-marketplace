{
  "name": "bb-plugin-pi-provider",
  "version": "0.1.0",
  "type": "module",
  "description": "Run bb threads with Pi, with pi-toolbox subagents in bb's native agent display, a /reload command, and every skill Pi loads in the / menu.",
  "license": "MIT",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "Pi",
    "description": "Run bb threads with Pi, with pi-toolbox subagents in bb's native agent display, a /reload command, and every skill Pi loads in the / menu.",
    "branding": {
      "icon": "./icons/pi.svg"
    },
    "server": "./server.ts",
    "host": "./src/host.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "bb-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-built-bridge.mjs"
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@radix-ui/react-slot": "^1.3.0",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.11.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cron-parser": "^5.10.1",
    "hono": "^4.13.11",
    "jsdom": "^26.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwind-merge": "^3.4.0",
    "typebox": "1.3.7",
    "typescript": "^5.7.0",
    "vitest": "^4.1.1"
  }
}
