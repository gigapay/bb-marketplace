{
  "name": "bb-plugin-github-kit",
  "version": "0.8.4",
  "type": "module",
  "engines": {
    "bb": ">=0.44",
    "bbPluginSdk": ">=0.5.29"
  },
  "bb": {
    "name": "GitHub Kit",
    "description": "Your GitHub PRs in BB: a PR tab per thread with live checks, reviewers, comments you can reply to, resolve and send to the agent, plus inline review comments in the diff.",
    "branding": {
      "icon": "./assets/github.svg",
      "experimental_icons": {
        "github": "./assets/github.svg"
      }
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "skills": [
      "skills"
    ]
  },
  "dependencies": {
    "@get-bb/plugin-sdk": "0.5.29",
    "@radix-ui/react-checkbox": "^1.3.7",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@pierre/diffs": "^1.2.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.11",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.4.0",
    "typescript": "^5.7.0"
  },
  "scripts": {
    "test": "node --experimental-strip-types --test shared/*.test.ts",
    "typecheck": "tsc -p ."
  }
}
