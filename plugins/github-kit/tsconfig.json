{
  "compilerOptions": {
    "strict": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": { "@/*": ["./*"] },
    "noEmit": true,
    "skipLibCheck": false,
    "allowImportingTsExtensions": true
  },
  "include": ["server.ts", "detail.ts", "checks.ts", "app.tsx", "components", "lib", "views", "shared"],
  "exclude": ["**/*.test.ts", "node_modules"]
}
